# Backend (Oracle): origin allowed to call the API via CORS.
FRONTEND_ORIGIN=https://mislineas.com.mx

# Frontend (Vercel): base URL of the API backend. Leave unset for local dev
# (same-origin /api/* routes).
NEXT_PUBLIC_API_URL=https://api.mislineas.com.mx

# Shared residential proxy pool, used by AT&T, Freedompop, and TalentoNet
# (Newww/RedAguila/Link Móvil). Format: host:port:user:pass, or
# http://user:pass@host:port. Comma-separated for rotation across multiple
# proxies. If omitted, requests go direct.
#
# All three block or rate-limit datacenter IPs; AT&T's anti-bot (Shape) also
# blocks non-Mexican residential exits, so the proxy must exit through Mexico.
# With DataImpulse that means appending __cr.mx to the username to force a MX
# exit (e.g. user__cr.mx:pass@host:port) — without it the pool exits
# worldwide and AT&T returns a 403 on every request.
#
# Dialo has no rate limiting observed even at volume, so it always goes
# direct and ignores this variable.
RESIDENTIAL_PROXIES=host:port:user__cr.mx:pass

# Path to Chrome/Chromium binary. Set automatically to /usr/bin/chromium
# inside the Docker image; override for local dev if needed.
CHROME_PATH=/usr/bin/google-chrome-stable

# Cloudflare Turnstile: public widget key, set on Vercel BEFORE building.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Backend only (.env.prod on Oracle). Never use a NEXT_PUBLIC_ prefix for this key.
TURNSTILE_SECRET_KEY=
# Exact frontend hostnames permitted in Siteverify responses (no scheme/port).
TURNSTILE_ALLOWED_HOSTNAMES=mislineas.com.mx
